# ==============================================================================
# Groww Review Pulse AI - Environment Configuration
# ==============================================================================

# Phase 2 LLM: Groq (openai/gpt-oss-120b or llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
GROQ_TPM_LIMIT=8000
GROQ_TPD_LIMIT=200000

# Phase 3 LLM: Google Gemini (gemini-3.6-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_RPM_LIMIT=15

# Play Store Settings
PLAY_STORE_PACKAGE_ID=com.nextbillion.groww
PLAY_STORE_COUNTRY=in
PLAY_STORE_LANGUAGE=en
WEEKS_LOOKBACK=8
MAX_REVIEWS_TO_FETCH=1000

# Google OAuth 2.0 Credentials (for Gmail & Google Docs MCP Server)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_TOKEN_PATH=./.config/google_token.json
# For headless cloud deployments (Railway/Docker):
GOOGLE_TOKEN_JSON=

# Delivery & Output Settings
DEFAULT_EMAIL_RECIPIENT=leadership@groww.in
OUTPUT_DIR=./output
ENABLE_LOCAL_FALLBACK=true
